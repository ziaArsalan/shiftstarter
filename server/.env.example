# Server environment — copy to .env and fill in. NEVER commit .env.
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"

# Supabase-managed Postgres (Project Settings → Database → Connection string)
# DATABASE_URL = pooled (pgbouncer, port 6543); DIRECT_URL = direct (port 5432, used for migrations)
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Supabase Auth + Storage + Admin API (Project Settings → API)
SUPABASE_URL="https://<ref>.supabase.co"
SUPABASE_ANON_KEY="<anon-public-key>"
SUPABASE_SERVICE_ROLE_KEY="<service-role-secret-key>"   # server-only; bypasses RLS — keep secret
# JWKS endpoint for verifying Supabase access tokens (asymmetric signing keys)
SUPABASE_JWKS_URL="https://<ref>.supabase.co/auth/v1/.well-known/jwks.json"

# Storage
STORAGE_PROVIDER="supabase"        # "supabase" (default) or "local" (tests/offline dev)
CREDENTIALS_BUCKET="credentials"   # private bucket for worker documents
BRAND_ASSETS_BUCKET="brand-assets" # public bucket for chain logos
UPLOAD_DIR="uploads"               # only used when STORAGE_PROVIDER=local
MAX_UPLOAD_MB=10

# Super-admin seed (used by `npm run seed` only — not required to boot the server)
SUPER_ADMIN_EMAIL="admin@shiftstarter.ca"
SUPER_ADMIN_PASSWORD="change-me-strong-admin-password"

# Stripe (M4)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
