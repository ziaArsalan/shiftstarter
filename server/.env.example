# Server environment — copy to .env and fill in. NEVER commit .env.
NODE_ENV=development
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/pharmacy_marketplace?schema=public"
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"

# Auth — JWT access signing + refresh handling (generate strong random secrets)
JWT_ACCESS_SECRET="change-me-access-min-16-chars"
JWT_REFRESH_SECRET="change-me-refresh-min-16-chars"
JWT_ACCESS_TTL="15m"
# Refresh token lifetime in days (opaque token, SHA-256 hashed in the DB)
REFRESH_TTL_DAYS=7
# Name of the httpOnly refresh cookie
REFRESH_COOKIE_NAME="ss_refresh"

# Credential document storage
STORAGE_PROVIDER="local"
UPLOAD_DIR="uploads"
MAX_UPLOAD_MB=10

# Admin seed (used by `npm run seed` only — not required to boot the server)
ADMIN_EMAIL="admin@shiftstarter.ca"
ADMIN_PASSWORD="change-me-strong-admin-password"

# Stripe (M4)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
