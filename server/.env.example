# Server environment — copy to .env and fill in. NEVER commit .env.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pharmacy_marketplace?schema=public"
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"

# Auth (generate strong random values)
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# Stripe (M4)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
